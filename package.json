{
  "name": "outlierhub-knowledge",
  "version": "0.1.0",
  "description": "Knowledge — biblioteca, busca, grafo e kanban locais. Código e exemplos originais sob MIT.",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-local.mjs dev",
    "build": "node scripts/next-local.mjs build",
    "start": "node scripts/next-local.mjs start",
    "lint": "eslint app components lib scripts middleware.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "check-publication": "node scripts/verificar-publicacao.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "jose": "^6.2.11",
    "js-yaml": "^5.2.2",
    "lucide-react": "^0.469.0",
    "next": "^15.3.0",
    "react": "19.0.0",
    "react-dom": "19.3.1",
    "react-force-graph-2d": "^1.29.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.31"
    }
  }
}
