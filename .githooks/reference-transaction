#!/bin/sh
# Páginas do template: a branch pagina/* não pode ser apagada nem renomeada (docs/paginas.md).
# O git chama este gancho a cada mudança de referência; sair com erro em "prepared" cancela a mudança.
[ "$1" = "prepared" ] || exit 0
while read -r old new ref; do
  case "$ref" in
    refs/heads/pagina/*)
      case "$new" in
        *[!0]*) ;; # o novo valor não é só zeros: a branch continua existindo
        *)
          echo "BLOQUEADO: '${ref#refs/heads/}' é a branch de uma página do template e não pode ser apagada nem renomeada (docs/paginas.md)." >&2
          exit 1
          ;;
      esac
      ;;
  esac
done
exit 0
