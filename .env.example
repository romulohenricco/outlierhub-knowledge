# =============================================================================
# Modelo de configuração. Copie para `.env.local` (já ignorado pelo git) e
# preencha SÓ o que for usar.
#
# TODAS as chaves abaixo saem em branco, e variável em branco vale como
# variável ausente. Sem nada preenchido o app sobe em modo demo (fixtures
# sintéticas em fixtures/demo/) e, em execução, não usa Supabase, Ollama nem
# rede. (A instalação e o build ainda baixam pacotes do npm e as fontes do
# Google Fonts: veja "Rede e privacidade" no README.)
#
# Este template não traz nenhum projeto, chave, conta ou dado: tudo que é
# externo (Supabase, Ollama, acesso, executor) é o SEU, configurado aqui.
# Nunca coloque segredo em variável NEXT_PUBLIC_*: ela vai para o navegador.
#
# O Next lê este arquivo ao iniciar: reinicie depois de editar. As variáveis
# NEXT_PUBLIC_* entram no pacote do navegador na hora do build (refaça
# `npm run build`). Os scripts de scripts/ NÃO leem este arquivo (último bloco).
# O formato dos arquivos de dados citados abaixo está em docs/dados.md.
# =============================================================================


# --- Provedor de dados --------------------------------------------------------
# Escolhe de onde vêm a BUSCA e o GRAFO. A estante e as referências leem sempre
# a pasta data/ e mostram dados de exemplo quando ela não tem os arquivos.
#   em branco ou "demo": fixtures sintéticas, sem infraestrutura externa.
#   "supabase": busca semântica no SEU Supabase + grafo lido de um sqlite local.
# Com "supabase", as variáveis da busca abaixo passam a ser obrigatórias. Se
# alguma faltar, o app mostra a tela "Provider não configurado" no lugar do app
# inteiro (menu, kanban e agente incluídos), dizendo o que falta. Para voltar ao
# demo, apague o valor. Qualquer outro valor impede o app de abrir.
BILHON_KNOWLEDGE_PROVIDER=


# --- Busca semântica: o seu projeto Supabase ----------------------------------
# Pré-requisito: rodar supabase/schema.sql no seu projeto (cria a tabela
# rag_chunks e a função match_rag_chunks_hybrid). Contrato completo em
# docs/provider-supabase.md. Use um projeto DEDICADO a este app: a chave
# service_role abaixo ignora a RLS em todas as tabelas do projeto.
#
# Se um carregador de segredos injeta o ambiente, ele precisa entregar o valor
# já resolvido: o app não resolve, e recusa, um valor que comece com op://
# (referência de um gerenciador de segredos, como o CLI do 1Password). Sem
# carregador, coloque o valor real aqui.

# URL do projeto (Project Settings > API), no formato https://<ref-do-projeto>.supabase.co
BILHON_SUPABASE_URL=

# Chave service_role do projeto. SEGREDO DE SERVIDOR: ela ignora RLS e tem
# acesso total ao banco. Fica só aqui (.env.local); nunca em NEXT_PUBLIC_*, em
# código de navegador ou no git. Se vazar, gere outra no painel do Supabase.
BILHON_SUPABASE_SERVICE_ROLE_KEY=

# Escopo da busca (obrigatório quando o provedor é "supabase"). Como a chave
# service_role ignora RLS, o alcance da busca precisa ser declarado: em branco
# a busca falha com erro explícito, nunca varre a base inteira por omissão.
# Duas formas válidas:
#   1) o nome de UM bucket (valor da coluna `bucket` em rag_chunks): a busca
#      fica restrita a ele. Com vários buckets, leia a nota sobre revocação do
#      HNSW em supabase/schema.sql e em docs/provider-supabase.md;
#   2) __TODO_O_CORPUS__ (valor opcional, escolha sua): assume todas as linhas
#      da tabela. A decisão fica registrada no log, uma vez por processo.
BILHON_KNOWLEDGE_BUCKET_FILTER=


# --- Embedding da pergunta (Ollama) -------------------------------------------
# Endereço do Ollama (gera o vetor da consulta, e também atende o autolearn e os
# scripts do grafo). Em branco: http://127.0.0.1:11434. Barras e espaços no fim
# são ignorados.
BILHON_OLLAMA_URL=

# Modelo de embedding. Em branco: bge-m3:latest. Use o MESMO modelo da ingestão
# dos trechos; a dimensão do vetor tem que bater com a coluna `embedding` do
# seu schema (o supabase/schema.sql usa 1024).
BILHON_EMBED_MODEL=


# --- Acesso fora do localhost -------------------------------------------------
# Um pedido é LOCAL (abre sem login) só quando o Host é localhost, 127.0.0.1 ou
# [::1] E o pedido não traz sinal de proxy ou túnel (cabeçalhos de
# encaminhamento). Todo o resto é externo e responde 403 até apresentar um JWT
# válido do Cloudflare Access do seu próprio time. Com os três em branco, só o
# acesso local funciona.
#
# Mantenha o app escutando só em 127.0.0.1 (o padrão de npm run dev e npm start).
# Leia docs/seguranca.md antes de expor o app: ele lista o que o app NÃO protege
# e como configurar o proxy (preservar o Host e enviar X-Forwarded-For e
# X-Forwarded-Proto, ou usar o Cloudflare Tunnel).

# Nome do time: o app usa https://<time>.cloudflareaccess.com (letras, números e hífen).
BILHON_ACCESS_TEAM=

# Application Audience (AUD) tag da aplicação no Cloudflare Access.
BILHON_ACCESS_AUD=

# E-mail autorizado a entrar (um só); o JWT precisa trazer esse e-mail.
BILHON_ACCESS_EMAIL=

# Lista (CSV) de hosts externos de referência. Reservada e sem efeito hoje: todo
# host que não seja local já exige Access, com ou sem esta lista. Deixe em branco.
BILHON_ACCESS_HOSTS=


# --- Executor externo (opcional) ----------------------------------------------
# Serviço SEU que recebe os tickets "escalados" do kanban. Sem a URL, o recurso
# fica desligado (a rota responde 503 e a interface não mostra o botão) e o
# resto do board funciona normalmente. O app faz um POST com JSON
# { "ticketId": "...", "toAgent": "..." } e espera status 2xx com
# { "ok": true, "task": { "id": "..." } }. Não envia credencial: proteja o
# executor por rede ou pelo seu próprio controle de acesso.

# Endereço do executor: http(s), sem usuário/senha na URL.
BILHON_EXECUTION_URL=

# Caminho do endpoint de escalonamento. Em branco: a própria URL é o endpoint.
BILHON_EXECUTION_PATH=

# Agente de destino quando o pedido não informa um. Em branco: o corpo enviado
# não leva o campo `toAgent`.
BILHON_EXECUTION_DEFAULT_AGENT=


# --- Primeiro uso dentro de um Megabrain --------------------------------------
# Este app foi feito para morar em <seu-megabrain>/apps/<pasta>. Quando a pasta
# acima de "apps" parece um Megabrain (tem knowledge/ e uma pasta do motor, como
# engine/), a primeira abertura pergunta se você quer popular o Knowledge com a base
# que já está lá, e a tarefa vira o primeiro card do kanban. A detecção é automática:
# deixe em branco. Se colocou o app em outro lugar, aponte aqui a raiz do seu
# Megabrain. O app só lê nomes e contagens de pastas; a integração é feita pelo seu
# agente de IA a partir do card. Detalhes em docs/megabrain.md.
BILHON_MEGABRAIN_ROOT=


# --- Raiz e diretórios de dados ------------------------------------------------
# Tudo opcional. Em branco = padrão dentro de ./data, que o git ignora e o
# template não traz. Os caminhos podem ser absolutos ou relativos à pasta de onde
# o app é iniciado (a raiz do projeto). Formato de cada arquivo: docs/dados.md.

# Raiz que delimita onde o app pode ler e gravar o estado da página Agente, dos
# add-ons e da topologia: tudo isso precisa ficar dentro dela, e symlinks que
# saem dela são recusados. Em branco: a pasta do projeto. Definir esta variável
# SUBSTITUI a raiz (não a soma à pasta do projeto): data/agente, data/addons e
# data/topology (ou as variáveis que as trocam) também precisam ficar dentro dela.
BILHON_ROOT=

# Página Agente (inventário somente leitura; formato dos arquivos em
# docs/agente-registro.md). Todos em branco = página vazia.
#   REGISTRO_ENTIDADES: arquivo (YAML ou JSON, dentro de BILHON_ROOT) com a lista
#                       de entidades (campo `entities`) a inventariar.
#   OWNERS_PROPRIOS   : CSV de donos (usuário ou organização do repositório)
#                       tratados como "próprios".
#   AGENTE_DIR        : pasta de estado da página (padrão data/agente).
#   REPOS_JSON / AGENTES_JSON: JSONs de repositórios e de espelhos (padrão:
#                       dentro de AGENTE_DIR).
BILHON_REGISTRO_ENTIDADES=
BILHON_OWNERS_PROPRIOS=
BILHON_AGENTE_DIR=
BILHON_REPOS_JSON=
BILHON_AGENTES_JSON=

# Ontologia (/ontologia): arquivo YAML ou JSON, dentro de BILHON_ROOT, com as
# camadas e os itens que você definir. Em branco = página com estado vazio.
# Formato em docs/ontologia.md.
BILHON_ONTOLOGIA_MANIFEST=

# Grafo do Agente (abas Radial e Neural; formatos em docs/agente-registro.md).
# Os dois ficam dentro de BILHON_ROOT. Em branco = padrão; ausentes = grafo sem essa fonte.
#   BRAIN_ORG_JSON: JSON com a sua organização (pilares, agentes, pessoas, tarefas,
#                   ferramentas). Padrão: <AGENTE_DIR>/organizacao.json
#   BRAIN_STORE   : pasta de notas .md ligadas por [[links]] (núcleo de memória).
#                   Padrão: <AGENTE_DIR>/memoria
BILHON_BRAIN_ORG_JSON=
BILHON_BRAIN_STORE=

# Add-ons: pasta com manifest.json e os artefatos aprovados (padrão data/addons).
BILHON_ADDONS_DIR=

# Camada de topologia do grafo: pasta com o extrato do disco, nodes.json e
# edges.json (padrão data/topology).
BILHON_TOPOLOGY_DIR=

# Personas (aba "Personas" de /ingestoes): JSON com a lista de personas, dentro de
# BILHON_ROOT. Em branco = aba vazia, que explica como popular. Formato e exemplo
# em docs/personas.md.
BILHON_PERSONAS_JSON=

# Kanban: pasta do board (padrão data/kanban).
BILHON_KANBAN_DIR=
# Nome do responsável atribuído a tickets classificados como "humano".
BILHON_KANBAN_EXECUTOR_HUMANO=
# Frases extras (CSV) que marcam um ticket como dependente de decisão humana.
BILHON_KANBAN_SINAIS_HUMANO=
# Autor padrão ao criar tickets na interface. NEXT_PUBLIC_*: entra no pacote do
# navegador na hora do build; não coloque nada sensível.
NEXT_PUBLIC_KANBAN_DEFAULT_AUTHOR=
# Projetos aceitos num ticket (CSV). Em branco: "geral" e "outro". O primeiro da
# lista é o projeto de um ticket novo. Também NEXT_PUBLIC_*: público no build.
NEXT_PUBLIC_KANBAN_PROJETOS=

# Minhas redes (/mysocialmedia): raiz com as pastas instagram-contas/,
# instagram-saves/ e youtube-playlists/ (padrão data/social; formato dos arquivos
# em docs/redes-sociais.md). Sem ela as telas ficam vazias e explicam o que
# colocar. A triagem grava só decisoes.json aí dentro; link simbólico que aponte
# para fora desta raiz é recusado. Independe de BILHON_ROOT.
BILHON_SOCIAL_DIR=
# 1 (ou true, sim): o navegador pede as miniaturas dos vídeos ao servidor de
# imagens do YouTube (i.ytimg.com). Em branco: ícone no lugar, nada sai da máquina.
BILHON_SOCIAL_YT_MINIATURAS=

# Biblioteca (estante). Padrões dentro de data/livros. Sem catálogo (arquivo
# ausente ou JSON inválido) a estante mostra os livros de exemplo.
#   CATALOGO : catalogo.json, um objeto { "livros": [...] } (NÃO um array)
#   LIVROS_DIR: arquivos dos livros (as capas ficam em .covers/ dentro dela)
#   LIVROS_DOMINIOS / LIVROS_HASHES: JSONs auxiliares do catálogo, no formato
#                { "porLivro": { "<id do livro>": "<valor>" } }
BILHON_CATALOGO=
BILHON_LIVROS_DIR=
BILHON_LIVROS_DOMINIOS=
BILHON_LIVROS_HASHES=
# Sinopses da estante e da página do livro: JSON no formato
# { "porLivro": { "<arquivo do livro>": { "sinopse": "..." } } }. Em branco: ao lado do
# niveis.json (padrão data/livros/livros-sinopses.json). Sem o arquivo, a estante usa a
# "justificativa" do niveis.json, quando houver. Gerador opcional: scripts/gerar-sinopses.mjs.
BILHON_LIVROS_SINOPSES=

# Coleções externas (stores sqlite por coleção; padrão data/colecoes-external)
# e a lista (CSV) de nomes de pasta de stores que NÃO devem aparecer como coleção.
BILHON_COLECOES_EXT=
BILHON_COLECOES_EXCLUIR=

# Grafo de conhecimento. Padrões em data/kg.
#   KG_DB: sqlite do grafo (esquema em docs/dados.md), lido só com o provedor
#          "supabase"; sem ele o canvas do grafo fica vazio, sem mensagem na tela
#          (exige a CLI sqlite3 no PATH; no Windows ela não vem instalada)
#   GRAPH_LAYOUT: posições pré-calculadas (x,y); gere com
#          `node scripts/graph-layout.mjs`
#   YOUTUBE_MAP / CLICKUP_MAP: JSONs que ligam um documento ao seu link externo.
#          No YOUTUBE_MAP, o campo `canal` precisa ser igual ao slug da coleção
#          (veja docs/dados.md, "Mapas de links")
BILHON_KG_DB=
BILHON_GRAPH_LAYOUT=
BILHON_YOUTUBE_MAP=
BILHON_CLICKUP_MAP=

# Sugestões do autolearn (Ollama local). Sem modelo a rota responde 503 em vez de
# escolher um modelo que a sua máquina pode nem ter baixado.
#   AUTOLEARN_MODEL: nome do modelo do Ollama que gera as sugestões.
#   AUTOLEARN_CACHE: onde ficam as sugestões já geradas (padrão
#          data/livros/autolearn-cache.json).
#   NIVEIS: JSON opcional (padrão data/livros/niveis.json), no formato
#          { "<arquivo do livro>": { "nivel": "referencia-academica" } } com nivel
#          = referencia-academica, profissional ou pratico-mercado. O template
#          não traz gerador desse arquivo.
#   AUTOLEARN_SEARCH_URL: modelo de URL http(s) com {query} no lugar do termo, por
#          exemplo https://sua-loja.example/busca?q={query}. Em branco, ou sem
#          {query}, sem http(s) ou com espaço, o painel não mostra o botão de
#          buscar a obra e fica só com "já temos?". Lida a cada pedido.
BILHON_AUTOLEARN_MODEL=
BILHON_AUTOLEARN_CACHE=
BILHON_NIVEIS=
BILHON_AUTOLEARN_SEARCH_URL=

# Referências (posts salvos). Padrão data/referencias-instagram (relativo,
# absoluto, com barra no fim ou barra normal: todos valem) e data/inbox.
# Os vídeos baixados vão para INBOX_* e são ligados por hardlink à pasta da
# referência: as duas pastas precisam estar no MESMO volume.
BILHON_REFERENCIAS_DIR=
BILHON_INBOX_SAVECLIP=
BILHON_INBOX_YOUTUBE=
# Formato do yt-dlp ao baixar vídeo. Em branco: teto de 720p
# (bv*[height<=720]+ba/b[height<=720]). Exige o yt-dlp instalado.
BILHON_YT_FORMAT=


# --- Scripts de linha de comando ------------------------------------------------
# O Next lê este arquivo; os scripts (scripts/*.py e scripts/*.mjs) leem o
# ambiente do terminal, NÃO o .env.local. Para trocar um valor nos scripts,
# exporte-o no terminal antes de rodar. Valem para eles:
#   BILHON_KG_DB         graph-layout.mjs, kg-extract.py e kg-normalize.py
#   BILHON_GRAPH_LAYOUT  só o graph-layout.mjs (os .py não geram o layout)
#   BILHON_OLLAMA_URL    kg-extract.py e kg-normalize.py
#   BILHON_EMBED_MODEL   só o kg-normalize.py (padrão do script: bge-m3)
#   BILHON_SINOPSES_MODEL, BILHON_OLLAMA_URL, BILHON_CATALOGO, BILHON_LIVROS_DIR,
#   BILHON_NIVEIS, BILHON_LIVROS_SINOPSES   só o gerar-sinopses.mjs
# Requisitos e efeito de cada script (Python 3.10+, numpy, pdftotext, sqlite3):
# docs/dados.md, seção "Scripts opcionais".

# Sinopses dos livros (scripts/gerar-sinopses.mjs).
#   BILHON_SINOPSES_MODEL: modelo de texto do seu Ollama que escreve as sinopses. Em
#                       branco, o script não gera nada (e não dá erro).
#   BILHON_OLLAMA_URL e BILHON_CATALOGO/BILHON_LIVROS_DIR/BILHON_NIVEIS/BILHON_LIVROS_SINOPSES
#                       valem aqui como no app.
BILHON_SINOPSES_MODEL=

# Extração do grafo (scripts/kg-extract.py).
#   BILHON_KG_COLECOES: coleções a amostrar (CSV). Em branco: descobre as pastas de
#                       data/colecoes-external/sources/ que tenham corpus.
#   KG_MODELO  : modelo do Ollama que extrai as relações. Em branco: qwen2.5:7b.
#   KG_DEADLINE_S / KG_V2_DEADLINE_S: limite de tempo da fase de LLM, em segundos
#                (extração e merge v2). Em branco: 1800 e 5400.
BILHON_KG_COLECOES=
KG_MODELO=
KG_DEADLINE_S=
KG_V2_DEADLINE_S=
